# Copy this file to .env for local development.
# Never commit real API tokens.

# Tiingo
MILBURN_TIINGO_API_SECRET=

# LLM
MILBURN_OLLAMA_BASE_URL=http://localhost:11434
MILBURN_DEFAULT_MODEL_PROFILE=default

# Logging
MILBURN_LOG_LEVEL=INFO
MILBURN_LOG_FORMAT=console

# OpenTelemetry
MILBURN_ENABLE_OTEL=false
MILBURN_OTEL_SERVICE_NAME=milburn
MILBURN_OTEL_EXPORTER_OTLP_ENDPOINT=

# App limits
MILBURN_MAX_RESPONSE_LENGTH=2048
