  "waves": [
    {
      "id": 0,
      "name": "Bootstrap verification",
      "execution": "root-only",
      "purpose": "Verify durable bootstrap records and repository state without re-evaluating the approved architecture."
    },
    {
      "id": 1,
      "name": "Foundation",
      "execution": "sequential",
      "purpose": "Establish package, contracts, event durability, and workflow interfaces used by every later worker."
    },
    {
      "id": 2,
      "name": "Independent boundaries",
      "execution": "parallel-after-dependencies",
      "purpose": "Implement isolated adapters and fakes against stable foundation interfaces."
    },
    {
      "id": 3,
      "name": "Coordination workflows",
      "execution": "dependency-limited-parallel",
      "purpose": "Connect agent roles, notifications, GitHub issues, and long-running coding."
    },
    {
      "id": 4,
      "name": "QA and recovery",
      "execution": "parallel-if-paths-remain-independent",
      "purpose": "Add independent validation, supervision, reconciliation, and crash recovery."
    },
    {
      "id": 5,
      "name": "Integrated proof",
      "execution": "sequential",
      "purpose": "Prove the complete workflow and product acceptance criteria."
    }
  ],
